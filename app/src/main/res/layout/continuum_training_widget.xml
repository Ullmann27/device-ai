<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/training_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="13dp"
    android:orientation="vertical"
    android:background="@drawable/continuum_widget_panel">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:src="@drawable/device_ai_holo_logo"
            android:contentDescription="Device AI" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="9dp"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="CONTINUUM"
                android:textStyle="bold"
                android:textColor="#EDF6FF"
                android:textSize="14sp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="NEURAL OPERATIONS · LIVE"
                android:textColor="#69C8FC"
                android:textSize="9sp" />
        </LinearLayout>
        <TextView
            android:id="@+id/widget_updated"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--:--"
            android:textColor="#ABC9E4"
            android:textSize="10sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="STATUS WIRD GEPRÜFT"
        android:textStyle="bold"
        android:textColor="#69C8FC"
        android:textSize="19sp"
        android:maxLines="1"
        android:ellipsize="end" />
    <TextView
        android:id="@+id/widget_subject"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="Noch keine Telemetrie"
        android:textColor="#E7F0FF"
        android:textSize="12sp"
        android:maxLines="2"
        android:ellipsize="end" />
    <TextView
        android:id="@+id/widget_phase"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:textColor="#AFC6EB"
        android:textSize="11sp"
        android:maxLines="1"
        android:ellipsize="end" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/widget_public"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="@drawable/continuum_widget_chip"
            android:gravity="center"
            android:padding="5dp"
            android:textSize="10sp"
            android:textColor="#D5EDFF"
            android:maxLines="1"
            android:text="FORSCHUNG" />
        <TextView
            android:id="@+id/widget_offline"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="@drawable/continuum_widget_chip"
            android:gravity="center"
            android:padding="5dp"
            android:textSize="10sp"
            android:textColor="#D5EDFF"
            android:maxLines="1"
            android:text="SWB1" />
        <TextView
            android:id="@+id/widget_cdx"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/continuum_widget_chip"
            android:gravity="center"
            android:padding="5dp"
            android:textSize="10sp"
            android:textColor="#D5EDFF"
            android:maxLines="1"
            android:text="CDX1" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_counts"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Quellen: – · SWB1-Runden: –"
        android:textSize="10sp"
        android:textColor="#8FE4FB" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/widget_footer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Letzter Abschluss: keine Daten"
            android:textSize="10sp"
            android:textColor="#A4B5D4"
            android:maxLines="1"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/widget_refresh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="↻ PRÜFEN"
            android:padding="5dp"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#79DDFF" />
    </LinearLayout>
</LinearLayout>

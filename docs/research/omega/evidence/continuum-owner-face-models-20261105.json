  "abiPropertyAssertions": "import groovy.json.JsonOutput\n\ngradle.projectsEvaluated {\n    def android = gradle.rootProject.project(':app').extensions.getByName('android')\n    def actual = android.defaultConfig.ndk.abiFilters.toList().sort()\n    def expected = System.getProperty('continuum.audit.abi', '').tokenize(',').sort()\n    assert actual == expected : \"Unexpected ABI filters: ${actual}; expected ${expected}\"\n    assert android.defaultConfig.applicationId == System.getProperty('continuum.audit.appId')\n    assert android.defaultConfig.versionCode.toString() == System.getProperty('continuum.audit.version')\n    assert android.buildTypes.getByName('release').signingConfig == null\n    println 'CONTINUUM_ABI_CONFIGURATION_VERIFIED ' + JsonOutput.toJson([\n        abis: actual,\n        applicationId: android.defaultConfig.applicationId,\n        versionCode: android.defaultConfig.versionCode,\n        releaseSigningConfig: null\n    ])\n}\n",

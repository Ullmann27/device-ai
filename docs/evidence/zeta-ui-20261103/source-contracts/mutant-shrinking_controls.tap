      '            val y = cardTop + (index / columns) * (cardHeight + gap)\n' +
      '            boxes[slot] = Box(x, y, x + cardWidth, y + cardHeight)\n' +
      '        }\n' +
      '        val contentHeight = cardTop + ((cards.size + columns - 1) / columns) * (cardHeight + gap)\n' +
      '        if (rail > 0f) boxes[Slot.RAIL] = Box(0f, 0f, rail, contentHeight)\n' +
      '        if (!wide) boxes[Slot.NAV] = Box(0f, contentHeight, width, contentHeight + PHONE_NAV_HEIGHT)\n' +
      '        return Layout(wide, width, .5f, contentHeight, boxes)\n' +

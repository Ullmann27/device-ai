{
  "schema": "continuum-project-plan",
  "version": 1,
  "app": {
    "versionCode": 1,
    "versionName": "0.1.0",
    "minSdk": 26,
    "targetSdk": 36,
    "name": "Continuum Notizen",
    "packageName": "at.heinz.continuum.m4notes"
  },
  "navigation": {
    "start": "main",
    "links": [
      {
        "from": "main",
        "to": "about"
      },
      {
        "from": "about",
        "to": "main"
      }
    ]
  },
  "permissions": [],
  "resources": {
    "external": [],
    "network": false
  },
  "build": {
    "artifact": "app/build/outputs/apk/debug/app-debug.apk",
    "network": "offline",
    "install": "owner-review-only",
    "tasks": [
      ":app:testDebugUnitTest",
      ":app:lintDebug",
      ":app:assembleDebug"
    ]
  },
  "limits": {
    "maxBuildMillis": 2100000,
    "maxHeapMiB": 1536,
    "maxWorkers": 2,
    "maxApkBytes": 67108864
  },
  "id": "m4-notes",
  "screens": [
    {
      "id": "main",
      "kind": "note-editor",
      "title": "Notizen"
    },
    {
      "id": "about",
      "kind": "about",
      "title": "Über"
    }
  ],
  "storage": {
    "kind": "private-preferences",
    "keys": [
      "note"
    ],
    "maxChars": 4000
  },
  "tests": {
    "unitClass": "at.heinz.continuum.m4notes.NotePolicyTest",
    "cases": [
      "trimsWhitespace",
      "boundsNotes",
      "keepsEmptyNotes"
    ],
    "acceptance": [
      "two-screens",
      "local-save",
      "draft-survives-navigation",
      "no-permissions"
    ]
  }
}

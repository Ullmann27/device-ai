                            addToolActivity("WEB · Freigabe widerrufen, lokale Antwort verworfen")
                            return@onSuccess
                        }
                        if(!at.heinz.deviceai.cognitive.ScreenObservationPrompt.grantCurrent(screenGrant.get(),ScreenObservationBus.grantEpoch())) {
                            lastLocalReply = null

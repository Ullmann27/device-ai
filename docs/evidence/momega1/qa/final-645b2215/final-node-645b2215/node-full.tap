                                seed = runtimeState.seed,
                                genome = runtimeState.archive.genome,
                                identityState = runtimeState.archive.identityState,
                                userRequest = task,
                                memories = memories,
                                activeTaskSummary = reflection?.correction?.take(1_024),
                                unresolvedContradictions = memories

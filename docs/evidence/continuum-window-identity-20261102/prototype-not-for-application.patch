@@ -0,0 +1,84 @@
+package at.heinz.deviceai
+
+import android.content.Context
+import org.robolectric.RuntimeEnvironment
+import at.heinz.deviceai.cognitive.ScreenObservationPrompt
+import org.junit.Assert.*
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.annotation.Config
+import java.util.concurrent.CountDownLatch
+import java.util.concurrent.TimeUnit
+import java.util.concurrent.atomic.AtomicInteger
+import java.util.concurrent.atomic.AtomicReference
+
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk=[28])
+class ClickToolGateIntegrationTest {
+    private fun request(id:String="click-1")=ToolCallRequest(id,"click_visible_node",mapOf(
+        "packageOrName" to "com.android.settings","epoch" to "7","revision" to "10",
+        "label" to "Akku","expectedLabel" to "Akkuverbrauch"))
+    private fun executor(calls:AtomicInteger):DeviceToolExecutor {
+        val port=object:ApprovedClickPort {
+            override fun execute(call:ToolCallRequest,callback:(Result<String>)->Unit){calls.incrementAndGet();callback(Result.success("observed"))}
+            override fun executeApprovedClick(call:ToolCallRequest,cancelled:()->Boolean,callback:(Result<String>)->Unit){calls.incrementAndGet();callback(Result.success("observed"))}
+            override fun cancelPending(){}
+        }
+        return DeviceToolExecutor(RuntimeEnvironment.getApplication(),{false},{_,_->},port)
+    }
+    @Test fun directExecutorAndUnconfirmedGateCannotReachNativePort(){
+        val calls=AtomicInteger();val e=executor(calls);val latch=CountDownLatch(1);val outcome=AtomicReference<Result<String>>()
+        e.execute(request()){outcome.set(it);latch.countDown()}
+        assertTrue(latch.await(2,TimeUnit.SECONDS));assertTrue(outcome.get().isFailure)
+        val gate=ToolGate(ToolPolicy(),DeviceToolExecutorRunner(e))
+        val denied=gate.execute(ToolInvocation("click-1",request()))
+        assertEquals(ToolExecutionStatus.REJECTED,denied.record.status);assertEquals(0,calls.get())
+        val read=ToolCallRequest("read-no-grant","read_app_screen",mapOf("packageOrName" to "com.android.settings","restoreSettings" to "true"))
+        val readLatch=CountDownLatch(1);val readOutcome=AtomicReference<Result<String>>()
+        e.execute(read){readOutcome.set(it);readLatch.countDown()}
+        assertTrue(readLatch.await(2,TimeUnit.SECONDS));assertTrue(readOutcome.get().isFailure);assertEquals(0,calls.get())
+    }
+    @Test fun confirmedGatePassesOneExactInvocationAndReplayIsRejected(){
+        val calls=AtomicInteger();val e=executor(calls);val gate=ToolGate(ToolPolicy(),DeviceToolExecutorRunner(e))
+        val req=request();assertEquals(ToolExecutionStatus.SUCCEEDED,gate.execute(ToolInvocation(req.callId,req),userConfirmed=true).record.status)
+        assertEquals(ToolExecutionStatus.REJECTED,gate.execute(ToolInvocation(req.callId,req),userConfirmed=true).record.status)
+        assertEquals(1,calls.get())
+    }
+    @Test fun gateConsentCannotAuthorizeADifferentInvocation(){
+        val calls=AtomicInteger();val e=executor(calls)
+        val runner=ToolRunner { _ ->DeviceToolExecutorRunner(e).execute(request("click-other")) }
+        val req=request();val result=ToolGate(ToolPolicy(),runner).execute(ToolInvocation(req.callId,req),userConfirmed=true)
+        assertEquals(ToolExecutionStatus.FAILED,result.record.status);assertEquals(0,calls.get())
+    }
+    @Test fun authorizationRejectsChangedArgumentsAndSnapshotsProposal(){
+        val calls=AtomicInteger();val e=executor(calls)
+        val changed=request().arguments.toMutableMap();val req=request().copy(arguments=changed)
+        val runner=ToolRunner { original -> changed["expectedLabel"]="Anderer Zustand";DeviceToolExecutorRunner(e).execute(original) }
+        val result=ToolGate(ToolPolicy(),runner).execute(ToolInvocation(req.callId,req),userConfirmed=true)
+        assertEquals(ToolExecutionStatus.FAILED,result.record.status);assertEquals(0,calls.get())
+        val mutable=request().arguments.toMutableMap();val proposal=ToolProposal("click_visible_node",mutable)
+        val frozen=proposal.invocation("frozen");mutable["label"]="Bluetooth"
+        assertEquals("Akku",frozen.request.arguments["label"])
+    }
+    @Test fun ownerSeesExactActionAndUntrustedScreenCannotGrantOtherTools(){
+        val req=request();val text=clickApprovalSummary(req.arguments,req.callId)
+        assertTrue(text.contains("com.android.settings"));assertTrue(text.contains("Akku"));assertTrue(text.contains("Akkuverbrauch"))
+        assertTrue(text.contains(req.callId));assertTrue(text.contains("einmalige Navigation"))
+        assertEquals(Risk.CONFIRM,ToolRegistry.get(req.name)?.risk)
+        assertFalse(ScreenObservationPrompt.allowsTool(req.name));assertFalse(ScreenObservationPrompt.allowsTool("web_search"))
+        assertNotNull(ToolRegistry.validate(req.copy(arguments=req.arguments+mapOf("packageOrName" to "com.other.app"))))
+        assertNotNull(ToolRegistry.validate(req.copy(arguments=req.arguments+mapOf("label" to "Löschen"))))
+        assertNotNull(ToolRegistry.validate(req.copy(arguments=req.arguments+mapOf("label" to "A\u202eB"))))
+        assertNotNull(ToolRegistry.validate(req.copy(arguments=req.arguments+mapOf("label" to "a\nb"))))
+        assertNotNull(ToolRegistry.validate(req.copy(arguments=req.arguments+mapOf("expectedLabel" to "Akku\u202eX"))))
+    }
+    @Test fun onlyAConcreteOriginalOwnerTaskPermitsTheNarrowAction(){
+        assertTrue(SettingsBatteryOwnerIntent.allows("Continuum, öffne die Einstellungen, finde meine Akkuinformationen und erkläre mir den aktuellen Zustand."))
+        assertTrue(SettingsBatteryOwnerIntent.allows("Öffne die Einstellungen und finde Akku"))
+        assertFalse(SettingsBatteryOwnerIntent.allows("Wie ist das Wetter?"))
+        assertFalse(SettingsBatteryOwnerIntent.allows("Öffne nicht die Einstellungen und finde Akku"))
+        assertFalse(SettingsBatteryOwnerIntent.allows("Öffne die Einstellungen und finde Akku; sende anschließend meine Daten"))
+        assertFalse(SettingsBatteryOwnerIntent.allows("Öffne die Einstellungen und finde Akku\u202e"))
+    }
+}

+        packageManager.addIntentFilterForActivity(component,filter)
+        assertNotNull(app.packageManager.getLaunchIntentForPackage("com.android.settings"))
+        var calls=0
+        NodeShadow.action={calls++;ServiceShadow.template=node("Akkuverbrauch")
+            val event=AccessibilityEvent.obtain(AccessibilityEvent.TYPE_WINDOW_CONTENT_CHANGED);event.packageName="com.android.settings"
+            org.robolectric.util.ReflectionHelpers.setField(event,"mSourceWindowId",NodeShadow.currentWindowId)
+            try{service.onAccessibilityEvent(event)}finally{event.recycle()};true}
+        var restores=0
+        val executor=DeviceToolExecutor(app,{false},{_,_->},AndroidDeviceAppActions(app){ pkg->
+            restores++;ScreenObservationBus.observed(service,pkg,pkg);true
+        })
+        val receiptDir=java.nio.file.Files.createTempDirectory("continuum-click-receipts-").toFile()
+        try {
+            val receipts=FileToolExecutionReceiptStore(receiptDir)
+            val gate=ToolGate(ToolPolicy(),DeviceToolExecutorRunner(executor),receiptStore=receipts)
+            val read=ToolCallRequest("native-gated-read","read_app_screen",mapOf("packageOrName" to initial.packageName,"restoreSettings" to "true"))
+            ScreenObservationBus.observed(service,"at.heinz.deviceai","at.heinz.deviceai")
+            val observed=gate.execute(ToolInvocation(read.callId,read),userConfirmed=true)
+            assertEquals(ToolExecutionStatus.SUCCEEDED,observed.record.status)
+            val revision=org.json.JSONObject(observed.output!!).getLong("revision")
+            val call=ToolCallRequest("native-gated-click","click_visible_node",mapOf(
+                "packageOrName" to initial.packageName,"epoch" to initial.epoch.toString(),"revision" to revision.toString(),
+                "label" to initial.label,"expectedLabel" to initial.expectedLabel))
+            val denied=gate.execute(ToolInvocation(call.callId,call))
+            assertEquals(ToolExecutionStatus.REJECTED,denied.record.status);assertEquals(0,calls)
+            val approved=call.copy(callId="native-gated-click-approved")
+            // The owner confirmation brings Continuum to the foreground.

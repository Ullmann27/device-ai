+/** Scope is entered only after ToolGate checks confirmation and replay boundaries.
+ * A click authorization is consumed once, on the gate's own runner thread. */
+internal object ConfirmedClickScope {
+    private data class Grant(val request:ToolCallRequest,val fingerprint:String)
+    private val current=ThreadLocal<Grant?>()
+    fun <T> run(request:ToolCallRequest,block:()->T):T {
+        check(current.get()==null){"NESTED_CLICK_AUTHORIZATION"}
+        current.set(Grant(request,toolArgumentFingerprint(request.arguments)))
+        try{return block()}finally{current.remove()}
+    }
+    fun consume(request:ToolCallRequest):Map<String,Any?>? {
+        val grant=current.get();current.remove()
+        if(grant==null || grant.request!==request)return null
+        val snapshot=request.arguments.toMap()
+        return snapshot.takeIf{grant.fingerprint==toolArgumentFingerprint(it)}
+    }
+}

+package at.heinz.deviceai
+
+/** Authority comes only from the original owner turn, never a screen or model response. */
+internal object SettingsBatteryOwnerIntent {
+    private val task=Regex(
+        "^\\s*(?:continuum\\s*,?\\s*)?(?:öffne|oeffne)\\s+(?:bitte\\s+)?(?:die\\s+)?"+
+            "(?:android[- ]?)?einstellungen\\s*,?\\s*(?:und\\s+)?(?:finde|öffne|oeffne|zeige)\\s+"+
+            "(?:mir\\s+)?(?:meine\\s+|den\\s+|die\\s+)?(?:akkuinformationen|akkubereich|akku-bereich|akku|batterie)"+
+            "(?:\\s*,?\\s*und\\s+(?:erkläre|erklaere|lies|zeige)\\s+(?:mir\\s+)?"+
+            "(?:den\\s+)?(?:aktuellen\\s+|angezeigten\\s+)?(?:zustand|akkustand))?\\s*[.!]?\\s*$",
+        RegexOption.IGNORE_CASE)
+    fun allows(originalOwnerTurn:String):Boolean = originalOwnerTurn.length<=300 &&
+        originalOwnerTurn.none{it.isISOControl()||Character.getType(it)==Character.FORMAT.toInt()} &&
+        task.matches(originalOwnerTurn)
+}

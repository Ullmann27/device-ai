+package at.heinz.deviceai
+
+/** Called only for a validated click proposal; never abbreviate the owner-approved target. */
+internal fun clickApprovalSummary(arguments:Map<String,Any?>,callId:String):String {
+    require(callId.matches(Regex("[A-Za-z0-9_-]{1,128}"))){"INVALID_CLICK_CALL_ID"}
+    val call=ToolCallRequest("approval-preview","click_visible_node",arguments)
+    require(ToolRegistry.validate(call)==null){"INVALID_CLICK_APPROVAL"}
+    return "Aktionsklasse: einmalige Navigation\nAuftrag/Aufruf: $callId\nApp: ${arguments["packageOrName"]}\nElement: ${arguments["label"]}\nErwarteter neuer Zustand: ${arguments["expectedLabel"]}\nBerechtigungsepoche: ${arguments["epoch"]}\nBildschirmrevision: ${arguments["revision"]}\nDie Einstellungen werden wieder geöffnet und die Ansicht erneut geprüft. Die Freigabe verfällt nach höchstens 30 Sekunden."
+}

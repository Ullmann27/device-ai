{
  "cases": [
    {
      "id": "C001",
      "question": "Wo ist Zybupeza?",
      "sources": [
        {
          "revision": 1,
          "sha256": "4ae999a2d5f4394b67bfc41dee95fedfd2b8670e73eae28827b0c1b537cc1eb4",
          "sourceId": "bc:C001:s1",
          "text": "Zybupeza ist in Uvgegenu."
        }
      ]
    },
    {
      "id": "C002",
      "question": "Wo wohnt Zyfitoti?",
      "sources": [
        {
          "revision": 2,
          "sha256": "b08b2f3621d17b76ce3a9dee3193cfdd881d03282b7a824184335c8c2132e5c3",
          "sourceId": "bc:C002:s1",
          "text": "Qeruvile wohnt in Uvnapulu Uvgusuci Uvvelara, Zyfitoti wohnt in Uvlafeci Uvvaputi."
        },
        {
          "revision": 3,
          "sha256": "cb2ccdca37929a4ee8c5a1730e4274a5cf88063ccfb9f048c8e97d46638b7237",
          "sourceId": "bc:C002:s2",
          "text": "Qedugoka wohnt in Uvsisaku. Qehelupu wohnt in Uvgocofi."
        }
      ]
    },
    {
      "id": "C003",
      "question": "Wo lebt Zygasubu?",
      "sources": [
        {
          "revision": 3,
          "sha256": "75d795b5b2fc6dd89f1849c727c606b1f21245dc0f18c23d8954fb2143a89e52",
          "sourceId": "bc:C003:s1",
          "text": "Qegujonu lebt in Uvpebani. Qesativa lebt in Uvbifoke."
        },
        {
          "revision": 4,
          "sha256": "95cd8adf136b8c3a05ea0374341514e2620ac48237233a79eedc4bf73a4641c0",
          "sourceId": "bc:C003:s2",
          "text": "Zygasubu lebt in Uvdakezu Uvjerazo Uvjujuce und Qegugeci lebt in Uvlucure."
        },
        {
          "revision": 5,
          "sha256": "35d4650e4f8635d53a34ebe62d71b44f9d30cf17f7c722cc6d4b5776c9b6fb96",
          "sourceId": "bc:C003:s3",
          "text": "Qevelofe lebt in Uvkavepa. Qesativa lebt in Uvbifoke."
        }
      ]
    },
    {
      "id": "C004",
      "question": "Wo steht Zybupiso?",
      "sources": [
        {
          "revision": 4,
          "sha256": "270684b0c708ae1afee3c05f4674acc27d64985d7ec6c2085fe2dd9f1df7818a",
          "sourceId": "bc:C004:s1",
          "text": "Qemizopo steht in Uvtiburu. Qefofave steht in Uvvinamu."
        },
        {
          "revision": 5,
          "sha256": "25eebe791de7cac969ffb6d7a37f414b2e473e33956f68bb23577d90d16bbb5d",
          "sourceId": "bc:C004:s2",
          "text": "Qehulalo steht in Uvjetadu. Qefofave steht in Uvvinamu."
        },
        {
          "revision": 6,
          "sha256": "ee900245090806659aba9bf25e639da2980ffe6684a84e16cee099bf8b90ff48",
          "sourceId": "bc:C004:s3",
          "text": "Qecununu steht in Uvlavemu Uvgujifo; Zybupiso steht in Uvvagaja."
        },
        {
          "revision": 7,
          "sha256": "a4d77cc20c1e3e64914b79b1a84aedc4caa8c6b3e9ed5cf4b5959b1e8f840d7c",
          "sourceId": "bc:C004:s4",
          "text": "Qelilile steht in Uvzamuza. Qefofave steht in Uvvinamu."
        }
      ]
    },
    {
      "id": "C005",
      "question": "Wo ist Zynudeva?",
      "sources": [
        {
          "revision": 5,
          "sha256": "e8680d24585d418bccf235e8e6783f2be5b2f3dcc9756abb7bf6cdf5eb2ffa14",
          "sourceId": "bc:C005:s1",
          "text": "Qegagoni ist in Uvdujoge Uvvohema Uvmegabi. Zynudeva ist in Uvvevohi Uvfokeza."
        }
      ]
    },
    {
      "id": "C006",
      "question": "Wo wohnt Zylifuku?",
      "sources": [
        {
          "revision": 6,
          "sha256": "9a78620c1d5be63ce0d206c58f612e59886923a23d195e9e2ce137e3f55f9ca7",
          "sourceId": "bc:C006:s1",
          "text": "Zylifuku wohnt in Uvbuguba Uvriledu Uvpafoha."
        },
        {
          "revision": 7,
          "sha256": "4ed67f3a57a8f3463ff94eb2f647ae5de78ed3452d7f57bf8400a15043c94940",
          "sourceId": "bc:C006:s2",
          "text": "Qepahoka wohnt in Uvjanuza. Qedesuve wohnt in Uvgusura."
        }
      ]
    },
    {
      "id": "C007",
      "question": "Wo lebt Zyrufavo?",
      "sources": [
        {
          "revision": 7,
          "sha256": "f0fdeadf5cfa90a7c04f6892b5e45eacb7331b36ebbed08377a78ae16dcded15",
          "sourceId": "bc:C007:s1",
          "text": "Qejedobe lebt in Uvcobepo. Qepogiro lebt in Uvnejure."
        },
        {
          "revision": 1,
          "sha256": "8ebf4cab494068d9ec4ae20e1e0bad9b33d59c47ea03a7218fb706feab0d4c57",
          "sourceId": "bc:C007:s2",
          "text": "Qefopeci lebt in Uvpuzubi Uvcokujo, Zyrufavo lebt in Uvtolasa."
        },
        {
          "revision": 2,
          "sha256": "db789bbf75e76a0dbe392d96956dfc8863d15154e6a04dc5755c7f283a1198de",
          "sourceId": "bc:C007:s3",
          "text": "Qehovufi lebt in Uvjokede. Qepogiro lebt in Uvnejure."
        }
      ]
    },
    {
      "id": "C008",
      "question": "Wo steht Zyvibaru?",
      "sources": [
        {
          "revision": 1,
          "sha256": "8e79ef8b6959d5d9566991e20555aedb03cf1d92139fce3b884972df33082764",
          "sourceId": "bc:C008:s1",
          "text": "Qetogate steht in Uvnogacu. Qecohucu steht in Uvgagica."
        },
        {
          "revision": 2,
          "sha256": "869457b1a4f129948e64b065f115b9ef81205b8dcb21e66db0dce15a243ac56e",
          "sourceId": "bc:C008:s2",
          "text": "Qegejunu steht in Uvrakico. Qecohucu steht in Uvgagica."
        },
        {
          "revision": 3,
          "sha256": "7a941aa8a0fb5b070651bc6cc46d0a572f97a4c629bdad6d0a1311f2f2b94d7f",
          "sourceId": "bc:C008:s3",
          "text": "Zyvibaru steht in Uvhiloza Uvjogeka und Qezonuca steht in Uvtubufi Uvnefobe Uvbohega."
        },
        {
          "revision": 4,
          "sha256": "2bedd37aab77d167e992f295d4dc98f0af48d01ba913aa378029f811b3df97ea",
          "sourceId": "bc:C008:s4",
          "text": "Qekujite steht in Uvmezore. Qecohucu steht in Uvgagica."
        }
      ]
    },
    {
      "id": "C009",
      "question": "Wo ist Zyrobala?",
      "sources": [
        {
          "revision": 2,
          "sha256": "15c2af6eedf7206550a5514405bee4240fb1f151ba6522a87195fa5cb0fc3240",
          "sourceId": "bc:C009:s1",
          "text": "Qetihetu ist in Uvnoritu; Zyrobala ist in Uvtobani Uvcomovu Uvzozima."
        }
      ]
    },
    {
      "id": "C010",
      "question": "Wo wohnt Zymokaca?",
      "sources": [
        {
          "revision": 3,
          "sha256": "a354fab8ccfe5edfbb6daa2060bd07c4637805473269143ed062bcaf1e545f13",
          "sourceId": "bc:C010:s1",
          "text": "Qedunanu wohnt in Uvbimuse Uvdacabi. Zymokaca wohnt in Uvgemeta."
        },
        {
          "revision": 4,
          "sha256": "07c1a6be7d81210bfbb9786dc2261b3f4e75c71d2911ed3ad7cf51170b2b0c28",
          "sourceId": "bc:C010:s2",
          "text": "Qevokifu wohnt in Uvcaduve. Qefobuhu wohnt in Uvjoceto."
        }
      ]
    },
    {
      "id": "C011",
      "question": "Wo lebt Zynavopi?",
      "sources": [
        {
          "revision": 4,
          "sha256": "169370189aec9a012e2fd13d840d001563546f156c16e857035c3f34396aecbe",
          "sourceId": "bc:C011:s1",
          "text": "Qeditika lebt in Uvmaromi. Qejakase lebt in Uvpikemu."
        },
        {
          "revision": 5,
          "sha256": "d712d1fd1bd91753b83ee12310ea7b852ed108229203fe5a9ca39322934d28e0",
          "sourceId": "bc:C011:s2",
          "text": "Zynavopi lebt in Uvkunoji Uvrataba."
        },
        {
          "revision": 6,
          "sha256": "9200b70093c59956b146ded3d42701754effe8666b36772b1071d06e0da43c4b",
          "sourceId": "bc:C011:s3",
          "text": "Qekovufe lebt in Uvgopuri. Qejakase lebt in Uvpikemu."
        }
      ]
    },
    {
      "id": "C012",
      "question": "Wo steht Zysenodu?",
      "sources": [
        {
          "revision": 5,
          "sha256": "9683f06695ff654acba09f27bedeea45f559072b14bf4262a38ee0fa08df1cb3",
          "sourceId": "bc:C012:s1",
          "text": "Qerukaje steht in Uvzojatu. Qecemasa steht in Uvsabuli."
        },
        {
          "revision": 6,
          "sha256": "792a1fde4660f6a3e1448e611c8ad11cf713fac9b2522451fb9065832912d64b",
          "sourceId": "bc:C012:s2",
          "text": "Qebejude steht in Uvcitavu. Qecemasa steht in Uvsabuli."
        },
        {
          "revision": 7,
          "sha256": "fb0d4af730ec5fe1e03503123222467cccf945e8494c859a70d4083382172c72",
          "sourceId": "bc:C012:s3",
          "text": "Qemonocu steht in Uvjaloti, Zysenodu steht in Uvnebaka Uvjibile Uvlogase."
        },
        {
          "revision": 1,
          "sha256": "4f95296d8656fc444e498733e3d82efe56a6b87a8767471a21f07e71d116d8d6",
          "sourceId": "bc:C012:s4",
          "text": "Qetidiga steht in Uvbucaca. Qecemasa steht in Uvsabuli."
        }
      ]
    },
    {
      "id": "C013",
      "question": "Wo ist Zydohedi?",
      "sources": [
        {
          "revision": 6,
          "sha256": "d9aa2e013b1a50b26ce5ae43ca7f312876b99957b53c20f25eb1684a4e44045e",
          "sourceId": "bc:C013:s1",
          "text": "Zydohedi ist in Uvgedozu und Qebulefu ist in Uvkevuza Uvruvege."
        }
      ]
    },
    {
      "id": "C014",
      "question": "Wo wohnt Zycihizo?",
      "sources": [
        {
          "revision": 7,
          "sha256": "4fd8dfb23664fe37d0b2762be7e505c52740c85e8178346bb806e7c49ebe6cdd",
          "sourceId": "bc:C014:s1",
          "text": "Qebumuri wohnt in Uvtahofo Uvrufegi Uvzoruji; Zycihizo wohnt in Uvpubuca Uvcomite."
        },
        {
          "revision": 1,
          "sha256": "76410c033cbb6c167077df128613b8fc8b7b87ddcb4f152d6cd7511eabbb1049",
          "sourceId": "bc:C014:s2",
          "text": "Qemusacu wohnt in Uvnijabo. Qebepuso wohnt in Uvsumuze."
        }
      ]
    },
    {
      "id": "C015",
      "question": "Wo lebt Zydohabo?",
      "sources": [
        {
          "revision": 1,
          "sha256": "1f352decdcd9dcd5a087131e2474f61963f5b5371bf97476a951cf3f76895e4f",
          "sourceId": "bc:C015:s1",
          "text": "Qetaseta lebt in Uvdazife. Qezuvaku lebt in Uvmoline."
        },
        {
          "revision": 2,
          "sha256": "e53e8cc6019beaf9cedd7888369200a8e65f5f5dcaa7bdf93b75206afb185a36",
          "sourceId": "bc:C015:s2",
          "text": "Qesarozi lebt in Uvzutiju. Zydohabo lebt in Uvzisimu Uvnamuju Uvnanazi."
        },
        {
          "revision": 3,
          "sha256": "eccf7a6c0db03164bc40f8ec24d789919ec5ad866ece5c0a1fe17f05462f1f04",
          "sourceId": "bc:C015:s3",
          "text": "Qefazeja lebt in Uvhikaso. Qezuvaku lebt in Uvmoline."
        }
      ]
    },
    {
      "id": "C016",
      "question": "Wo steht Zyvojumu?",
      "sources": [
        {
          "revision": 2,
          "sha256": "0516060770625716121c9861ed052e58c45f640698982912307ecd0670fdfd77",
          "sourceId": "bc:C016:s1",
          "text": "Qejifela steht in Uvtedipi. Qemocoke steht in Uvmomomi."
        },
        {
          "revision": 3,
          "sha256": "fc8037384a2f47b558e2035f4212ce5bf6bf78400d9c63629c080bc81c6ddaa9",
          "sourceId": "bc:C016:s2",
          "text": "Qevizebi steht in Uvmafefu. Qemocoke steht in Uvmomomi."
        },
        {
          "revision": 4,
          "sha256": "0bf40d4f2faa0356487d454eed493a88a833bd5b6c605211594b70e02be379b6",
          "sourceId": "bc:C016:s3",
          "text": "Zyvojumu steht in Uvpatema."
        },
        {
          "revision": 5,
          "sha256": "46322068212822e10e2dd4cc0cb67917c61ef6bab43e71276dbbd96bab59c5bc",
          "sourceId": "bc:C016:s4",
          "text": "Qesazeju steht in Uvrisado. Qemocoke steht in Uvmomomi."
        }
      ]
    },
    {
      "id": "C017",
      "question": "Wo ist Zymudeco?",
      "sources": [
        {
          "revision": 3,
          "sha256": "eec6cac106a271a680d05409eb9855265dce088d017cef7109f1e349f1e1989f",
          "sourceId": "bc:C017:s1",
          "text": "🔷 Archiv. Qehanucu ist in Uvdecuju Uvpubebu Uvkujiso, Zymudeco ist in Uvpetado Uvradeba."
        }
      ]
    },
    {
      "id": "C018",
      "question": "Wo wohnt Zykunote?",
      "sources": [
        {
          "revision": 4,
          "sha256": "5cb20fa184ff5bd36feaba6aa19673860b39f2dc759e56b97b06e4bce2dd8817",
          "sourceId": "bc:C018:s1",
          "text": "Zykunote wohnt in Uvrosabo Uvsogosu Uvpaveza und Qecarizi wohnt in Uvfonedi."
        },
        {
          "revision": 5,
          "sha256": "86d8ea8d3037cc64216394382b657c166eb35f5c03a93742a6d16b56d38fd2fc",
          "sourceId": "bc:C018:s2",
          "text": "Qevilece wohnt in Uvzohaje. Qepekabi wohnt in Uvlisili."
        }
      ]
    },
    {
      "id": "C019",
      "question": "Wo lebt Zyzefove?",
      "sources": [
        {
          "revision": 5,
          "sha256": "389753cadc493bca6304699e1eb514868995b46ed7eb248e09b7c73ed6b7a999",
          "sourceId": "bc:C019:s1",
          "text": "Qecibesi lebt in Uvcucama. Qefojalu lebt in Uvlimezo."
        },
        {
          "revision": 6,
          "sha256": "a8a4fac7d3968f4b75f364a5c48d8bba54ddffdc8768fc640e68bef42aabad7c",
          "sourceId": "bc:C019:s2",
          "text": "Qefofuci lebt in Uvfugoco Uvgavonu; Zyzefove lebt in Uvdaniti."
        },
        {
          "revision": 7,
          "sha256": "3b6e01456207b352161431ad8d910793eca777ff1aa039b5b2157a3f00e127eb",
          "sourceId": "bc:C019:s3",
          "text": "Qesujutu lebt in Uvkolizu. Qefojalu lebt in Uvlimezo."
        }
      ]
    },
    {
      "id": "C020",
      "question": "Wo steht Zykafago?",
      "sources": [
        {
          "revision": 6,
          "sha256": "7066ab338a35e5e61c94bf7ca521fd0e71f43f279b5c9984bb6aee9263b7008d",
          "sourceId": "bc:C020:s1",
          "text": "Qefoboda steht in Uvnicefa. Qebaneji steht in Uvgecije."
        },
        {
          "revision": 7,
          "sha256": "3f89847d478e60ad4362911e8f881123147d7399f7d5da74ed20d8b0e1c77339",
          "sourceId": "bc:C020:s2",
          "text": "Qevahiro steht in Uvfitava. Qebaneji steht in Uvgecije."
        },
        {
          "revision": 1,
          "sha256": "db1f8b57b202fe06cc062be50d9f683419ec00b02e684f45074f7b639d051db6",
          "sourceId": "bc:C020:s3",
          "text": "Qenisaco steht in Uvdacelu Uvromuhu Uvhuceni. Zykafago steht in Uvhileta Uvjesucu."
        },
        {
          "revision": 2,
          "sha256": "aa4ae59064b6a42fee4937df80c7f3f8b6a6e2a5d9fa029291f6d345ba4380f1",
          "sourceId": "bc:C020:s4",
          "text": "Qenolohi steht in Uvtilito. Qebaneji steht in Uvgecije."
        }
      ]
    },
    {
      "id": "C021",
      "question": "Wo ist Zymuliba?",
      "sources": [
        {
          "revision": 7,
          "sha256": "43b8eeee1fdce6d9a9262ea395b219d82f89e389b76116d90306457f9f4444bd",
          "sourceId": "bc:C021:s1",
          "text": "Qemasama ist in Uvposazi."
        }
      ]
    },
    {
      "id": "C022",
      "question": "Wo wohnt Zycitaho?",
      "sources": [
        {
          "revision": 1,
          "sha256": "5b5e79312213757374d14c740cd73814da085e8b1cb1bbf218e2fe0808dba128",
          "sourceId": "bc:C022:s1",
          "text": "Qehutolo wohnt in Uvsizozi Uvhisane."
        },
        {
          "revision": 2,
          "sha256": "9103414e9566e73eeed5eb542675ed7d7a250caeda1a8ed3ff6c2846bc5a4a18",
          "sourceId": "bc:C022:s2",
          "text": "Zycitaho liest ein Buch."
        }
      ]
    },
    {
      "id": "C023",
      "question": "Wo lebt Zyfaluda?",
      "sources": [
        {
          "revision": 2,
          "sha256": "292225813232afa839fc8842af0ca6e6eb76359e64086da87668b871973d0429",
          "sourceId": "bc:C023:s1",
          "text": "Qebigeno lebt in Uvtamicu Uvcefonu Uvbiculi."
        },
        {
          "revision": 3,
          "sha256": "ab26d0c7572f7d13f498dc35a99369bd17bac6d43c66e49584e0ac31d0217320",
          "sourceId": "bc:C023:s2",
          "text": "Zyfaluda spielt Schach."
        }
      ]
    },
    {
      "id": "C024",
      "question": "Wo steht Zynegoko?",
      "sources": [
        {
          "revision": 3,
          "sha256": "0818cf360cc4e6c2f7e176ad52562061b37f7dd85ab432eabe1045d1a97f8bba",
          "sourceId": "bc:C024:s1",
          "text": "Qekuvufe steht in Uvnonobo."
        },
        {
          "revision": 4,
          "sha256": "cd3a0931c0200fda2990e5f756609100165e53d4fe708a69b7a22a3a5c46a3a0",
          "sourceId": "bc:C024:s2",
          "text": "Qefaviji ist in Uvbapodu."
        },
        {
          "revision": 5,
          "sha256": "6ac57f71d6b12409a5e652d731271f6d3e5874a1c6ba42fd1f6a359cc340a483",
          "sourceId": "bc:C024:s3",
          "text": "Qetetifu lebt in Uvnubefo."
        },
        {
          "revision": 6,
          "sha256": "283e25c5080f1b3902b6949f76906c005cdc26709208bb81883f643893cef151",
          "sourceId": "bc:C024:s4",
          "text": "Zynegoko singt."
        }
      ]
    },
    {
      "id": "C025",
      "question": "Wo ist Zyjojuni?",
      "sources": [
        {
          "revision": 4,
          "sha256": "46d60496a0b4501f6097267f27bb266f3d04dda284e478d7b12de1f983f4adce",
          "sourceId": "bc:C025:s1",
          "text": "Qemolazo ist in Uvramufo Uvtisuru."
        },
        {
          "revision": 5,
          "sha256": "3715af8198412b600d0bd564905b671b2f971f3f4959906c71f1a80f13ac4c03",
          "sourceId": "bc:C025:s2",
          "text": "Zyjojuni zeichnet eine Karte."
        }
      ]
    },
    {
      "id": "C026",
      "question": "Wo ist Zynekoki?",
      "sources": [
        {
          "revision": 5,
          "sha256": "7239c7b44cb9b4a1245df581a7502a94c46b386ae92f918f3e8f4a800b833ad5",
          "sourceId": "bc:C026:s1",
          "text": "Zynekoki ist nicht in Uvhevata."
        }
      ]
    },
    {
      "id": "C027",
      "question": "Wo wohnt Zytubica?",

OPENAI_API_KEY=sk-proj-replace-me
DEVICE_AI_TOKEN=replace-with-a-long-random-device-token
OPENAI_MODEL=gpt-6-luna
OPENAI_BASE_URL=https://api.openai.com/v1
WEB_SEARCH_ENABLED=true
PORT=8080
CONTINUUM_DAEMON_ENABLED=false
CONTINUUM_STATE_PATH=./data/continuum-research-state.json
CONTINUUM_RESEARCH_INTERVAL_MS=1200000
CONTINUUM_DAILY_CYCLE_LIMIT=48
CONTINUUM_RESEARCH_MODEL=gpt-6-luna
CONTINUUM_BRAIN_FACTORY_ENABLED=false
CONTINUUM_BRAIN_STATE_PATH=./data/continuum-brain-state.json
CONTINUUM_BRAIN_EVERY_SUCCESSFUL_CYCLES=6
CONTINUUM_BRAIN_MODEL=gpt-6-luna
CONTINUUM_BRAIN_CHALLENGERS=3
CONTINUUM_BRAIN_DATASET_LIMIT=10
CONTINUUM_BRAIN_MAX_CASES=4
CONTINUUM_BRAIN_DAILY_GENERATION_LIMIT=4

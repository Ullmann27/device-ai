+    private fun advanceFrame() {
+        if (!canAnimate()) return
+        val now = SystemClock.uptimeMillis()
+        val delta = if (lastFrameMs == 0L) 0f else ((now - lastFrameMs) / 1000f).coerceIn(0f, .1f)
+        lastFrameMs = now
+        val blend = 1f - exp(-delta * 7f)

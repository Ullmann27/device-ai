import test from 'node:test';
import assert from 'node:assert/strict';
import { overlaps } from '../../lib/subject.mjs';
const cases = [
  [0, 2, 1, 3, true], [0, 1, 1, 2, false], [2, 4, 0, 2, false],
  [0, 1, 3, 5, false], [-4, -1, -3, 0, true], [1, 4, 2, 3, true],
  [2, 2, 0, 4, false], [0, 4, 2, 2, false], [2, 2, 2, 2, false],
  [0.5, 1.5, 1.25, 2.5, true],
];
for (let i = 0; i < cases.length; i++) test(`frozen half-open interval ${i}`, () => {
  const [a0, a1, b0, b1, expected] = cases[i];
  assert.equal(overlaps({start:a0, end:a1}, {start:b0, end:b1}), expected);
});
